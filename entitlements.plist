<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone access (paired with NSMicrophoneUsageDescription in Info.plist) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Let Jarvis add items to the Reminders app -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Required so an ad-hoc-signed bundle can load its bundled native libs
         (onnxruntime, PortAudio) and run the embedded Python -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
